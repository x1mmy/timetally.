# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=secret-key

# Employee PIN storage (server-side only, min 32 chars)
# Generate with: openssl rand -base64 48
# Do not change or lose this once PINs are stored: every employee PIN would stop working
EMPLOYEE_PIN_SECRET=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# For local subdomain testing
# Add to /etc/hosts:
# 127.0.0.1 admin.timetally.local
# 127.0.0.1 testclient.timetally.local
